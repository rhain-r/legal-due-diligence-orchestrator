# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- LLM providers -----------------------------------------------------------
# Reasoning engine for Lead / Worker / Verifier agents
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Second opinion / cross-model verification (see docs/build-plan.md, Phase 7)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- Runtime limits ----------------------------------------------------------
# Hard ceiling on agent turns per audit, so a verification loop can't run away.
MAX_AGENT_TURNS=25
# Only escalate to the Verifier above this many findings per worker.
VERIFIER_ALWAYS_ON=true

# --- Paths -------------------------------------------------------------------
INBOX_DIR=./data/incoming
REPORT_DIR=./reports
