# --- Secrets -----------------------------------------------------------------
.env
.env.*
*.key
*.pem

# --- Client documents --------------------------------------------------------
# Real contracts must never reach the remote. Synthetic fixtures we authored are
# the only PDFs allowed in this repository.
*.pdf
!agent/tests/fixtures/**/*.pdf
data/

# Golden contracts are rendered from agent/evals/corpus.py on demand. The text
# is the reviewable source; the PDFs are build artifacts.
agent/evals/golden/build/

# --- Agent run artifacts -----------------------------------------------------
runs/
reports/
*.audit.json

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- Claude Code -------------------------------------------------------------
# Shared project config is committed; personal overrides are not.
.claude/settings.local.json
